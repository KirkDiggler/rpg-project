{
  "C_Cpp.default.compileCommands": "${workspaceFolder}/.vscode/compile_commands.json",
  "C_Cpp.default.cppStandard": "c++20",
  "files.associations": {
    "*.uproject": "json",
    "*.uplugin": "json",
    "*.ini": "ini",
    "*.Build.cs": "csharp",
    "*.Target.cs": "csharp"
  },
  "files.exclude": {
    "**/Binaries": true,
    "**/DerivedDataCache": true,
    "**/.vs": true,
    "**/Plugins/RpgWire/Source/ThirdParty": true,
    "**/Private/pb": true,
    "**/Content": true,
    "**/Saved": true,
    "**/Intermediate": true,
    "**/.vscode/ipch": true
  },
  "search.exclude": {
    "**/Binaries": true,
    "**/Intermediate": true,
    "**/Saved": true,
    "**/DerivedDataCache": true,
    "**/Content": true,
    "**/AssetLab/native-anim": true,
    "**/AssetLab/glb": true,
    "**/Plugins/RpgWire/Source/ThirdParty": true,
    "**/Private/pb": true,
    "**/.vscode/ipch": true
  },
  "files.watcherExclude": {
    "**/Binaries": true,
    "**/Intermediate": true,
    "**/Saved": true,
    "**/DerivedDataCache": true,
    "**/Content": true,
    "**/Plugins/RpgWire/Source/ThirdParty": true,
    "**/Private/pb": true,
    "**/.vscode/ipch": true
  },
  "python.defaultInterpreterPath": "/home/kirk/UnrealEngine/UE_5.9/Engine/Binaries/ThirdParty/Python3/Linux/bin/python3",
  "python.analysis.extraPaths": [
    "${workspaceFolder}/Intermediate/PythonStub"
  ],
  "python.analysis.diagnosticSeverityOverrides": {
    "reportMissingModuleSource": "none",
    "reportMissingImports": "warning"
  },
  "task.problemMatchers.warnings": "skip",
  "clangd.arguments": [
    "--compile-commands-dir=${workspaceFolder}/.vscode",
    "--background-index",
    "-j=8",
    "--completion-style=detailed",
    "--header-insertion=never"
  ]
}
